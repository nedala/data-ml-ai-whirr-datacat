# DataHub side stack — optional non-secret overrides. Copy to .env (same
# folder) to use. NO SECRETS HERE: the system client secret, frontend
# secret, token-service keys, DB password and admin password are generated on
# first run into ${DATA_ROOT}/datahub/secrets/datahub.env (0600). PG_PASS,
# GCP_SA_JSON and OIDC client secrets come from the calling environment
# (Studio's vault / your shell), never from a file in the repo.

# Usually set by `make APPLIANCE=data|ml|ai` — override only if needed:
# ATTACH_NETWORK=bsp-data-net
# DATA_ROOT=./data/data
# DATAHUB_PORT=38081
# DATAHUB_PROJECT=bsp_datahub

# Public URL people use (OIDC redirect base). Default https://localhost:<port>
# DATAHUB_PUBLIC_HOST=appliance.example.internal
# DATAHUB_PUBLIC_URL=https://appliance.example.internal:38081

# Entra ID SSO: reuses Studio's OIDC_TENANT_ID / OIDC_CLIENT_ID /
# OIDC_CLIENT_SECRET from the environment. To use a separate app
# registration, set DATAHUB_OIDC_CLIENT_ID / DATAHUB_OIDC_DISCOVERY_URI here
# and pass DATAHUB_OIDC_CLIENT_SECRET via the environment.
# DATAHUB_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DATAHUB_OIDC_DISCOVERY_URI=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# DATAHUB_OIDC_USER_NAME_CLAIM=preferred_username

# Ingestion
# DATAHUB_ENV=PROD
# PG_HOST=postgres
# PG_DB=bsp_edw
# PG_USER=analyst
# TRINO_HOST=trino
# TRINO_CATALOGS=warehouse bigquery
# GCP_PROJECT_ID=to-be-named-soon
# DBT_TARGET_DIR=../../dbt_project/target
