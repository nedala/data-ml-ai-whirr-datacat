# ── DataPlatform Data & AI Appliances — NON-SECRET configuration ───────────
# Copy to .env (`make up` does it for you). Per-appliance values (project
# name, ports, persona, data root) live in appliances/{data,ml,ai}.env and
# are loaded OVER this file by `make up APPLIANCE=data|ml|ai`.
#
# Service passwords and enterprise keys are NOT configured here. Studio
# generates service credentials into the encrypted vault
# (<data root>/vault/vault.json, AES-256-GCM, key derived from the master
# passphrase); enterprise keys (GCP_SA_JSON, M365_CLIENT_SECRET,
# ATLAN_API_TOKEN, SAP_BRIM_USER/PASSWORD, ANTHROPIC_API_KEY) are set in
# Studio → Credentials and injected at start time.

# dev | preprod | prod  (prod/preprod: Entra ID sign-in only)
APPLIANCE_ENV=dev

# Front door: bind address and the host name people type in the browser
# (goes into the dev TLS certificate SANs and VS Code's trusted origins)
FACADE_BIND=0.0.0.0
PUBLIC_FACADE_HOST=localhost
# Host name shown in direct-port links (noVNC); usually = PUBLIC_FACADE_HOST
NOVNC_HOST=localhost
# Dedicated ports bind to loopback by default. Set to 0.0.0.0 ONLY to expose
# them to a trusted LAN on purpose (noVNC is protected by the VNC password,
# Open WebUI by the Studio gate).
NOVNC_BIND=127.0.0.1
OPENWEBUI_BIND=127.0.0.1

# Images (make build). Leave empty for the defaults.
APPLIANCE_IMAGE=
BROWSER_IMAGE=

# Whose workspace folders the appliance binds to
USER_HANDLE=analyst

# Vault master passphrase. Leave EMPTY to type it on Studio's unlock screen
# after each restart (recommended). Dev convenience only: set it here or
# point APPLIANCE_MASTER_PASSWORD_FILE at a 0600 file.
APPLIANCE_MASTER_PASSWORD=
APPLIANCE_MASTER_PASSWORD_FILE=

# Identity — empty = local Studio users; "oidc" = Microsoft Entra ID SSO
# (docs/platform/sso.md). OIDC_REDIRECT_URI is set per appliance.
SSO_PROVIDER=
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUP=
# Comma-separated UPNs / e-mails that sign in as admin (in addition to the group)
# Delegated Microsoft Graph scopes requested at SSO so the M365 tools can act as the
# signed-in user (empty = identity only). Users consent on their next sign-in, if the tenant allows it.
OIDC_GRAPH_SCOPES=
OIDC_ADMIN_USERS=
# e-mail domain for local users in the X-Auth-Email header (<handle>@<domain>)
STUDIO_LOCAL_EMAIL_DOMAIN=local

# Egress — every container reaches the internet ONLY via px-proxy, which
# enforces <data root>/egress/allowlist.yaml (edit in Studio → Egress).
#   EGRESS_MODE: enforce | audit
#   EGRESS_UPSTREAM_PROXY: chain to a corporate / host proxy
#   EGRESS_EXTRA_HOSTS: extra allowed hosts, comma-separated host[:port]
EGRESS_MODE=enforce
EGRESS_UPSTREAM_PROXY=
EGRESS_EXTRA_HOSTS=

# BigQuery / Vertex AI (non-secret; the key is GCP_SA_JSON in the vault)
GCP_PROJECT_ID=to-be-named-soon
GCP_REGION=us-central1
BQ_LOCATION=US

# Claude Code on Vertex (ADC comes from the identity in Studio → Cloud identities).
# auto = use Vertex only when VERTEX_CLAUDE_MODEL names an enabled model;
# 1 = always use Vertex; 0 = keep Claude's own Anthropic sign-in.
CLAUDE_VERTEX=auto
VERTEX_CLAUDE_MODEL=

# Microsoft 365 / Power BI / Atlan / SAP BRIM (non-secret; empty = mock)
M365_TENANT_ID=
M365_CLIENT_ID=
SHAREPOINT_SITE=
DISPUTES_MAILBOX=billing-disputes@example.net
CCAI_SHAREPOINT_SITE=
CCAI_SHAREPOINT_FOLDER=CCAI/CallLogs
POWERBI_WORKSPACE_ID=
ATLAN_BASE_URL=https://atlan.example.com
# SAP BRIM host is allowed through px-proxy automatically when set
SAP_BRIM_BASE_URL=
SAP_BRIM_MODE=mock

# dbt default target: postgres (local warehouse) | bigquery | trino
DBT_TARGET=postgres

# Desktop browser
BROWSER_GEOMETRY=1920x1080x24
BROWSER_HOME_URL=about:blank
# Antigravity tile on the launchpad (0 = hide; it also hides by itself when the
# Linux Desktop image was built with `make build ANTIGRAVITY=0` or the install failed)
ANTIGRAVITY_ENABLED=1

# Build-time proxy for `make build` (pip/apt/curl during docker build)
BUILD_HTTP_PROXY=

# ── Bootstrap credentials: seeded into the vault ONCE (empty slots only);
# afterwards edit them in Studio → Credentials. NAME_FILE = path from the repo root.
# Vertex models offered in OpenCode etc. (verified for this project/region)
VERTEX_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite
LLM_PROVIDER=
GCP_SA_JSON_FILE=
M365_CLIENT_SECRET=
ATLAN_API_TOKEN=
SAP_BRIM_USER=
SAP_BRIM_PASSWORD=
ANTHROPIC_API_KEY=

# ── Prehydrated service passwords (optional) ─────────────────────────────
# Studio generates any of these that are left empty. Set one here to choose
# it yourself: it is copied into the vault the first time the service starts,
# and from then on the vault is the source of truth (rotate it in Studio →
# Credentials). PG_PASS only takes effect before the warehouse is first
# initialised; after that, rotate it from Studio.
PG_PASS=
JUPYTER_TOKEN=
CODE_PASSWORD=
VNC_PASSWORD=
MCP_TOKEN=
SUPERSET_ADMIN_PASS=
SUPERSET_SECRET_KEY=
WEBUI_SECRET_KEY=
