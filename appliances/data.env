# ── DataPlatform appliance overlay: data — loaded OVER .env by `make up APPLIANCE=data`
# (and by Studio for every compose call). One compose project, port set and
# data root per appliance, so all three run side by side.
APPLIANCE=data
COMPOSE_PROJECT_NAME=bsp_data
APPLIANCE_NETWORK=bsp-data-net
APPLIANCE_PERSONA=data-pro
FACADE_PORT=31201
DATA_ROOT=./data/data
# dedicated host ports (loopback by default; see docs/platform/desktop.md)
NOVNC_PORT=36081
OPENWEBUI_PORT=37081
DATAHUB_PORT=38081
CDP_PORT=9222
MCP_PORT=8765
# Entra ignores the port of http://localhost redirect URIs, so this matches an
# already-registered http://localhost:<any>/auth/callback (docs/platform/sso.md)
SSO_CALLBACK_PORT=31211
OIDC_REDIRECT_URI=http://localhost:31211/auth/callback
