# ── DataPlatform appliance overlay: ml — loaded OVER .env by `make up APPLIANCE=ml`
# (and by Studio for every compose call). One compose project, port set and
# data root per appliance, so all three run side by side.
APPLIANCE=ml
COMPOSE_PROJECT_NAME=bsp_ml
APPLIANCE_NETWORK=bsp-ml-net
APPLIANCE_PERSONA=ml-scientist
FACADE_PORT=31202
DATA_ROOT=./data/ml
# dedicated host ports (loopback by default; see docs/platform/desktop.md)
NOVNC_PORT=36082
OPENWEBUI_PORT=37082
DATAHUB_PORT=38082
CDP_PORT=9223
MCP_PORT=8766
# Entra ignores the port of http://localhost redirect URIs, so this matches an
# already-registered http://localhost:<any>/auth/callback (docs/platform/sso.md)
SSO_CALLBACK_PORT=31212
OIDC_REDIRECT_URI=http://localhost:31212/auth/callback
