# ── DataPlatform appliance overlay: ai — loaded OVER .env by `make up APPLIANCE=ai`
# (and by Studio for every compose call). One compose project, port set and
# data root per appliance, so all three run side by side.
APPLIANCE=ai
COMPOSE_PROJECT_NAME=bsp_ai
APPLIANCE_NETWORK=bsp-ai-net
APPLIANCE_PERSONA=ai-engineer
FACADE_PORT=31203
DATA_ROOT=./data/ai
# dedicated host ports (loopback by default; see docs/platform/desktop.md)
NOVNC_PORT=36083
OPENWEBUI_PORT=37083
DATAHUB_PORT=38083
CDP_PORT=9224
MCP_PORT=8767
# Entra ignores the port of http://localhost redirect URIs, so this matches an
# already-registered http://localhost:<any>/auth/callback (docs/platform/sso.md)
SSO_CALLBACK_PORT=31213
OIDC_REDIRECT_URI=http://localhost:31213/auth/callback
